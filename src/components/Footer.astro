---
import { SOCIAL_LINKS } from '../consts';
---

<footer class="site-footer">
  <ul>
    {SOCIAL_LINKS.map(({ label, href }) => (
      <li><a href={href} rel="me noopener">{label}</a></li>
    ))}
    <li><a href="/feed.xml">RSS</a></li>
  </ul>
  <p>© {new Date().getFullYear()} Anthony Piccolo · Melbourne</p>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }
  a {
    color: var(--muted);
  }
  a:hover {
    color: var(--ink);
  }
  p {
    margin: 0;
  }
</style>
